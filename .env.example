# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (required)
DATABASE_URL="postgresql://ovsrcsc:change-me@localhost:5432/ovsrcsc?schema=public"

# Authentication / secrets (generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-at-least-32-random-characters"
IP_HASH_SECRET="replace-with-at-least-32-random-characters"

# First administrator provisioning (used only by npm run admin:create)
ADMIN_EMAIL="director@example.org"
ADMIN_NAME="Center Director"
ADMIN_PASSWORD=""

# Media storage
# local (default): files under MEDIA_ROOT. NOT persistent on Vercel — uploads are
#   refused there unless Blob is configured.
# blob: Vercel Blob (private; served through /media). Used automatically when
#   BLOB_READ_WRITE_TOKEN is set (create a Blob store in the Vercel project).
#   Copy existing files with: npm run media:migrate-to-blob [-- --apply]
MEDIA_STORAGE=""
BLOB_READ_WRITE_TOKEN=""
MEDIA_ROOT="./storage/media"
MEDIA_PUBLIC_BASE_URL="/media"
MAX_IMAGE_UPLOAD_MB=8
MAX_DOCUMENT_UPLOAD_MB=20

# Institution-facing schedules are always interpreted in this time zone
INSTITUTION_TIME_ZONE="Asia/Kolkata"

# Resend email service (required for password-reset and enquiry notifications)
RESEND_API_KEY=""
MAIL_FROM=""
ENQUIRY_NOTIFICATION_EMAIL=""

# Automatic translation (Google Cloud Translation) — server-side only.
# Never use NEXT_PUBLIC_ names for these. Set ONE of:
#   GOOGLE_TRANSLATE_CREDENTIALS_JSON  service-account key JSON (raw or base64),
#     role "Cloud Translation API User"; v3 API. Optional GOOGLE_TRANSLATE_PROJECT_ID.
#   GOOGLE_TRANSLATE_API_KEY           API key restricted to the Cloud Translation API; v2 API.
GOOGLE_TRANSLATE_CREDENTIALS_JSON=""
GOOGLE_TRANSLATE_PROJECT_ID=""
GOOGLE_TRANSLATE_API_KEY=""
