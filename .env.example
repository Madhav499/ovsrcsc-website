# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (required)
DATABASE_URL="postgresql://ovsrcsc:change-me@localhost:5432/ovsrcsc?schema=public"

# Authentication / secrets (generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-at-least-32-random-characters"
IP_HASH_SECRET="replace-with-at-least-32-random-characters"

# First administrator provisioning (used only by npm run admin:create)
ADMIN_EMAIL="director@example.org"
ADMIN_NAME="Center Director"
ADMIN_PASSWORD=""

# Media storage (local disk by default; replaceable with S3-compatible storage)
MEDIA_ROOT="./storage/media"
MEDIA_PUBLIC_BASE_URL="/media"
MAX_IMAGE_UPLOAD_MB=8
MAX_DOCUMENT_UPLOAD_MB=20

# Institution-facing schedules are always interpreted in this time zone
INSTITUTION_TIME_ZONE="Asia/Kolkata"

# Resend email service (required for password-reset and enquiry notifications)
RESEND_API_KEY=""
MAIL_FROM=""
ENQUIRY_NOTIFICATION_EMAIL=""
