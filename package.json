{
  "name": "ovsrcsc-website",
  "version": "1.0.0",
  "private": true,
  "description": "Shri O. V. Sheth Regional Community Science Center, Rajkot - public website and role-based CMS",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "content:inventory": "tsx scripts/build-content-inventory.ts",
    "content:migrate": "tsx scripts/migrate-content.ts",
    "content:assets": "tsx scripts/download-assets.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-three/fiber": "^9.8.2",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-link": "3.32.1",
    "@tiptap/extension-placeholder": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "argon2": "0.45.1",
    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "2.35.0",
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "2.17.0",
    "sharp": "^0.34.4",
    "three": "^0.187.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/sanitize-html": "2.16.0",
    "@types/three": "^0.187.0",
    "cheerio": "1.1.2",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.45.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.4": true
  }
}
